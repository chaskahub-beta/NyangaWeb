# Nyanga Beauty & Spa — Apache / LiteSpeed (Hostinet)

DirectoryIndex index.html
Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Forzar HTTPS (se activa solo cuando el certificado SSL está instalado)
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)(:\d+)?$
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # /api/... → api/index.php
  RewriteCond %{REQUEST_URI} !/api/index\.php$
  RewriteRule ^api/ api/index.php [L,QSA]
</IfModule>

# Archivos ocultos (.git, .env…) nunca se sirven
<FilesMatch "^\.">
  Require all denied
</FilesMatch>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "DENY"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; frame-src https://www.openstreetmap.org; form-action 'self'; frame-ancestors 'none'; base-uri 'self'"
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  # Las páginas se comprueban siempre: así las actualizaciones se ven enseguida
  # (CSS y JS llevan ?v=… en index.html, por eso pueden guardarse más tiempo)
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType text/css "access plus 1 day"
  ExpiresByType application/javascript "access plus 1 day"
</IfModule>

AddType image/webp .webp
AddType text/calendar .ics
