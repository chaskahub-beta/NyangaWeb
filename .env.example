# Copiez ce fichier en .env et remplissez les valeurs.

# Adresse publique du site (utilisée dans les liens de paiement et les e-mails)
PORT=5500
PUBLIC_URL=http://localhost:5500

# Adresse affichée dans le rendez-vous ajouté à l'agenda (.ics / Google)
BUSINESS_ADDRESS=Nyanga Beauty & Spa, Granges-Narboz, France

# Panel de l'entreprise (/admin)
ADMIN_PASSWORD=
# Chaîne longue et aléatoire (ex. : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
SESSION_SECRET=

# SumUp : clé API secrète (sk_...) et code marchand.
# Laisser vide = paiements simulés (page de test).
SUMUP_API_KEY=
SUMUP_MERCHANT_CODE=

# E-mails (SMTP). Laisser SMTP_HOST vide = les e-mails sont enregistrés dans data/outbox.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Nyanga Beauty & Spa <contact@exemple.fr>"
COMPANY_EMAIL=contact@exemple.fr

# Base de données (fichier SQLite)
# DB_PATH=data/nyanga.db
